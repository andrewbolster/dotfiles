[user]
	name = Andrew Bolster
	email = andrew.bolster@gmail.com
	signingkey = 8D625EB8D718E9CC
[commit]
	gpgsign = true
[pull]
	rebase = true
[color]
	status = always
	diff = always
[gpg]
	program = gpg
[core]
	editor = vim
	autocrlf = input
[credential]
	helper = cache
[diff]
	tool = vimdiff
[difftool]
	prompt = false
[alias]
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	wdiff = diff --color-words
