[user]
	name = Andrew Bolster
[pull]
	rebase = true
[color]
	status = always
	diff = always
[core]
	editor = vim
	autocrlf = input
[credential]
	helper = cache
[diff]
	tool = vimdiff
[difftool]
	prompt = false
[alias]
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	wdiff = diff --color-words
